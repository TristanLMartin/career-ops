# career-ops MCP server settings. `npm run setup` copies this to .env and fills in the token.
# .env is gitignored; never commit it.

# Secret token. Clients send it as "Authorization: Bearer <token>" or in the URL path /mcp/<token>.
# 32+ random characters. Anyone who has it can read and update your job search.
CAREER_OPS_MCP_TOKEN=

# Where the server listens. Keep 127.0.0.1 and put a tunnel (Tailscale Funnel, Cloudflare
# Tunnel, ...) in front of it rather than binding a public interface.
CAREER_OPS_MCP_HOST=127.0.0.1
CAREER_OPS_MCP_PORT=8765

# The career-ops checkout (default: the folder this mcp/ directory sits in).
# CAREER_OPS_CODE_ROOT=..

# Profiles: comma list of id=profileDir@dashboardUrl. profileDir is relative to the code root
# ("." = the default profile); dashboardUrl is that profile's running web UI.
CAREER_OPS_MCP_PROFILES=me=.@http://127.0.0.1:3000
# CAREER_OPS_MCP_PROFILES=me=.@http://127.0.0.1:3000,partner=profiles/partner@http://127.0.0.1:3001
# CAREER_OPS_MCP_DEFAULT_PROFILE=me
