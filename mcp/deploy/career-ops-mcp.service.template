# systemd user unit for the career-ops MCP server. `npm run setup -- --systemd` writes a copy with
# the paths filled in to ~/.config/systemd/user/career-ops-mcp.service. By hand: replace
# @MCP_DIR@ and @NODE@, then:
#   systemctl --user daemon-reload && systemctl --user enable --now career-ops-mcp
#   loginctl enable-linger "$USER"   # optional: keep it running when you are logged out
[Unit]
Description=career-ops MCP server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@MCP_DIR@
# Token and settings (CAREER_OPS_MCP_*). The server never logs the token.
EnvironmentFile=@MCP_DIR@/.env
ExecStart=@NODE@ src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
